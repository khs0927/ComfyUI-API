# Controller
VIDEO_API_TOKEN=replace-with-a-long-random-token
PUBLIC_BASE_URL=https://your-space-name.hf.space
VIDEO_DATA_ROOT=./video-data
VIDEO_SCENE_PARALLELISM=1
FFMPEG_PRESET=veryfast
FFMPEG_CRF=20

# Free-first local/remote ComfyUI worker
COMFYUI_URL=http://127.0.0.1:8188
COMFYUI_VIDEO_WORKFLOW=workflows/ltx23_video_api.json
COMFYUI_SCENE_TIMEOUT=1800

# Optional Hugging Face public/ZeroGPU Space demo provider
HF_TOKEN=
HF_VIDEO_SPACE_ID=Lightricks/ltx-video-distilled
HF_VIDEO_SPACE_API_NAME=/generate

# Optional paid fallback
FAL_KEY=
FAL_VIDEO_ENDPOINT=fal-ai/ltx-2.3/text-to-video
