# Controller
VIDEO_API_TOKEN=replace-with-a-long-random-token
PUBLIC_BASE_URL=https://your-public-https-endpoint.example
VIDEO_DATA_ROOT=./video-data
VIDEO_SCENE_PARALLELISM=1
VIDEO_PROVIDER_ORDER=beam,kaggle,hf,helios,wan21,comfyui
VIDEO_ALLOW_MOCK=false
FFMPEG_PRESET=veryfast
FFMPEG_CRF=20

# Primary remote worker: Beam + Helios-Distilled
# Copy the task queue invocation URL printed by: beam deploy workers/beam_helios.py:generate
BEAM_TASK_QUEUE_URL=
BEAM_TOKEN=
# Current deployments normally print Bearer. Change to Basic only when the
# invocation example printed by your Beam deployment explicitly says Basic.
BEAM_AUTH_SCHEME=Bearer
BEAM_TASK_STATUS_URL=https://api.beam.cloud/v2/task/{task_id}/
BEAM_POLL_SECONDS=10
BEAM_SCENE_TIMEOUT=21600
# Local guardrail measured in requested output seconds, not Beam billing units.
BEAM_DAILY_VIDEO_SECONDS=1200

# Secondary batch worker: official Kaggle CLI + private GPU kernel
KAGGLE_KERNEL_ID=your-kaggle-username/open-video-worker
KAGGLE_KERNEL_TITLE=Open video fallback worker
KAGGLE_WORKER_TEMPLATE=workers/kaggle_helios
KAGGLE_ACCELERATOR=gpu
KAGGLE_ENABLE_INTERNET=true
KAGGLE_POLL_SECONDS=30
KAGGLE_SCENE_TIMEOUT=21600
KAGGLE_DAILY_VIDEO_SECONDS=600
# Credentials are read from the official Kaggle CLI authentication sources.
# Never commit real credential values.
KAGGLE_API_TOKEN=

# Tertiary free-quota fallback: verified public Hugging Face Gradio Space preset.
# helios_realtime is Apache-2.0 and currently running on ZeroGPU.
HF_TOKEN=
HF_VIDEO_SPACE_PRESET=helios_realtime
HF_DAILY_VIDEO_SECONDS=120
# Advanced manual override. Leave blank when using a preset.
HF_VIDEO_SPACE_ID=
HF_VIDEO_SPACE_API_NAME=
HF_VIDEO_SPACE_INPUTS_JSON=[]
HF_VIDEO_SPACE_KWARGS_JSON={}

# Optional local fallback: Apache-2.0 Helios-Distilled
HELIOS_ROOT=./vendor/Helios
HELIOS_INFER_SCRIPT=./vendor/Helios/infer_helios.py
HELIOS_MODEL=BestWishYsh/Helios-Distilled
HELIOS_PYTHON=python

# Optional low-VRAM local fallback: Apache-2.0 Wan2.1-T2V-1.3B
WAN21_ROOT=./vendor/Wan2.1
WAN21_MODEL=./models/Wan2.1-T2V-1.3B
WAN21_PYTHON=python
WAN21_NATIVE_FPS=16

# Optional fully local ComfyUI workflow using Wan/Helios only
COMFYUI_URL=http://127.0.0.1:8188
COMFYUI_VIDEO_WORKFLOW=workflows/wan21_t2v_api.json
COMFYUI_SCENE_TIMEOUT=7200

# Reserved future provider slot. It is intentionally inactive and never selected by default.
MODAL_ENABLED=false
MODAL_ENDPOINT_URL=
MODAL_TOKEN=
