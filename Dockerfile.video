FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    VIDEO_DATA_ROOT=/data \
    PORT=7860

RUN apt-get update && apt-get install -y --no-install-recommends \
    ffmpeg curl git ca-certificates fonts-noto-cjk \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY requirements-video.txt ./
RUN pip install --no-cache-dir -r requirements-video.txt
COPY . .
RUN mkdir -p /data/outputs /data/work

EXPOSE 7860
CMD ["sh", "-c", "uvicorn video_api:app --host 0.0.0.0 --port ${PORT:-7860}"]
